# Groq API Key (Get it from https://console.groq.com/) -- used for chat
GROQ_API_KEY=your_groq_key

# Google Gemini API Key (Get it from https://aistudio.google.com/apikey)
# -- used for image understanding and OCR (the /upload image path)
GEMINI_API_KEY=your_api_key

# Flask Configuration
FLASK_DEBUG=true
FLASK_PORT=5000

# Optional: Database URL (Defaults to local SQLite if not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
