%% ContextShift layer diagram: current architecture.
%% See docs/architecture.md for the accompanying explanation of each
%% layer and the dependency rules this diagram encodes.

graph TD
    subgraph Application
        App1["app.py"]
        App2["models.py"]
        App3["config.py"]
    end

    subgraph Adapters
        Adapter["adapters.py"]
    end

    subgraph Library["ContextShift Library"]
        Strategies["strategies/"]
        Tokenizers["tokenizers/"]
        LLM["llm/"]
        Summarization["summarization/"]
        Ingestion["ingestion/"]
    end

    subgraph Core["Core Types"]
        CoreTypes["core/"]
    end

    App1 --> Adapter
    Adapter --> Strategies
    Adapter --> Tokenizers
    Adapter --> LLM
    Adapter --> Summarization
    Adapter --> Ingestion

    Strategies --> CoreTypes
    LLM --> CoreTypes
    Summarization --> CoreTypes
    Ingestion --> CoreTypes

    Summarization --> LLM

    %% Tokenizers has no dependency on CoreTypes or anything else in the
    %% package -- token estimation operates on a plain string, not a
    %% Message. Strategies has no dependency on Tokenizers -- strategies
    %% trust a precomputed token count rather than measuring text
    %% themselves. Both omissions are intentional, not missing edges.
