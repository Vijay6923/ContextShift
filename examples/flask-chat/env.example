# Copy this file to .env (cp env.example .env) and fill in your keys.

# OpenRouter API Key (Get it from https://openrouter.ai/keys) -- used for chat
OPENROUTER_API_KEY=your_openrouter_key

# Optional: override the chat model (any OpenRouter model id works)
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Google Gemini API Key (Get it from https://aistudio.google.com/apikey)
# -- used for image understanding and OCR (the /upload image path)
GEMINI_API_KEY=your_api_key

# Flask Configuration
FLASK_DEBUG=true
FLASK_PORT=5000

# Optional: Database URL (Defaults to local SQLite if not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
